[require]
GLSL >= 1.20
GL_ARB_shader_texture_lod

[fragment shader]
#extension GL_ARB_shader_texture_lod : require
uniform sampler3D tex;
uniform vec3 coord;
uniform float level;
void main() { gl_FragColor = texture3DLod(tex, coord, level); }

[test]
texture volume-mip-colors 0
uniform int tex 0
uniform float level 0
uniform vec3 coord 0.125 0.5 0.125
draw rect -1 -1 2 2
probe all rgba 0.0 0.0 0.0 1
uniform float level 0
uniform vec3 coord 0.375 0.5 0.125
draw rect -1 -1 2 2
probe all rgba 0.0 0.0 0.3333333333333333 1
uniform float level 0
uniform vec3 coord 0.625 0.5 0.125
