uniform vec3 coord 0.875 0.5 0.375
draw rect -1 -1 2 2
probe all rgba 0.0 0.3333333333333333 1.0 1
uniform vec3 coord 0.125 0.5 0.625
draw rect -1 -1 2 2
probe all rgba 0.0 0.6666666666666666 0.0 1
uniform vec3 coord 0.375 0.5 0.625
draw rect -1 -1 2 2
probe all rgba 0.0 0.6666666666666666 0.3333333333333333 1
uniform vec3 coord 0.625 0.5 0.625
draw rect -1 -1 2 2
probe all rgba 0.0 0.6666666666666666 0.6666666666666666 1
uniform vec3 coord 0.875 0.5 0.625
draw rect -1 -1 2 2
probe all rgba 0.0 0.6666666666666666 1.0 1
uniform vec3 coord 0.125 0.5 0.875
draw rect -1 -1 2 2
probe all rgba 0.0 1.0 0.0 1
uniform vec3 coord 0.375 0.5 0.875
