[require]
GLSL >= 1.20
GL_ARB_shader_texture_lod

[fragment shader]
#extension GL_ARB_shader_texture_lod : require
uniform samplerCube tex;
uniform vec3 coord;
uniform float level;
void main() { gl_FragColor = textureCubeLod(tex, coord, level); }

[test]
texture cube-mip-colors 0
uniform int tex 0
uniform float level 0
uniform vec3 coord 1 0 0
draw rect -1 -1 2 2
probe all rgba 0.0 0.0 0 1
uniform float level 0
uniform vec3 coord -1 0 0
draw rect -1 -1 2 2
probe all rgba 0.2 0.0 0 1
uniform float level 0
uniform vec3 coord 0 1 0
draw rect -1 -1 2 2
probe all rgba 0.4 0.0 0 1
uniform float level 0
uniform vec3 coord 0 -1 0
draw rect -1 -1 2 2
probe all rgba 0.6 0.0 0 1
uniform float level 0
uniform vec3 coord 0 0 1
draw rect -1 -1 2 2
probe all rgba 0.8 0.0 0 1
uniform float level 0
uniform vec3 coord 0 0 -1
draw rect -1 -1 2 2
probe all rgba 1.0 0.0 0 1
uniform float level 1
uniform vec3 coord 1 0 0
draw rect -1 -1 2 2
probe all rgba 0.0 0.5 0 1
uniform float level 1
uniform vec3 coord -1 0 0
draw rect -1 -1 2 2
probe all rgba 0.2 0.5 0 1
uniform float level 1
uniform vec3 coord 0 1 0
draw rect -1 -1 2 2
probe all rgba 0.4 0.5 0 1
uniform float level 1
uniform vec3 coord 0 -1 0
draw rect -1 -1 2 2
probe all rgba 0.6 0.5 0 1
uniform float level 1
uniform vec3 coord 0 0 1
draw rect -1 -1 2 2
probe all rgba 0.8 0.5 0 1
uniform float level 1
uniform vec3 coord 0 0 -1
draw rect -1 -1 2 2
probe all rgba 1.0 0.5 0 1
uniform float level 2
uniform vec3 coord 1 0 0
draw rect -1 -1 2 2
probe all rgba 0.0 1.0 0 1
uniform float level 2
uniform vec3 coord -1 0 0
draw rect -1 -1 2 2
probe all rgba 0.2 1.0 0 1
uniform float level 2
uniform vec3 coord 0 1 0
draw rect -1 -1 2 2
probe all rgba 0.4 1.0 0 1
uniform float level 2
uniform vec3 coord 0 -1 0
draw rect -1 -1 2 2
probe all rgba 0.6 1.0 0 1
uniform float level 2
uniform vec3 coord 0 0 1
draw rect -1 -1 2 2
probe all rgba 0.8 1.0 0 1
uniform float level 2
uniform vec3 coord 0 0 -1
draw rect -1 -1 2 2
probe all rgba 1.0 1.0 0 1
