[require]
GLSL >= 1.20

[fragment shader]
uniform samplerCube tex;
uniform float level;
void main() {
    vec2 p = (gl_FragCoord.xy - vec2(125.0)) / 512.0;
    gl_FragColor = textureCube(tex, vec3(1.0, p.y, -p.x), level);
}

[test]
texture cube-mip-colors 0
uniform int tex 0
uniform float level 8
draw rect -1 -1 2 2
probe all rgba 0 0.0 0 1
uniform float level 9
draw rect -1 -1 2 2
probe all rgba 0 0.5 0 1
uniform float level 10
draw rect -1 -1 2 2
probe all rgba 0 1.0 0 1
