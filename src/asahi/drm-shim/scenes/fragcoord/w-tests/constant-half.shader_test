[require]
GLSL >= 1.10

[vertex shader]
attribute vec4 vertex;
void main() { gl_Position = vertex;  }

[fragment shader]
void main() { gl_FragColor = vec4(gl_FragCoord.w * 0.25, 0.0, 0.0, 1.0); }

[vertex data]
vertex/float/4
-2 -2 0 2
6 -2 0 2
-2 6 0 2

[test]
clear color 0.0 0.0 0.0 0.0
clear
draw arrays GL_TRIANGLES 0 3
probe rgba 25 25 0.12500000 0 0 1
probe rgba 125 125 0.12500000 0 0 1
probe rgba 200 200 0.12500000 0 0 1
probe rgba 240 10 0.12500000 0 0 1
probe rgba 10 240 0.12500000 0 0 1
