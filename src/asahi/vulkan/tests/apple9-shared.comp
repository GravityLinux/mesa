#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint src[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint dst[]; };
layout(push_constant) uniform Params { uint count; uint salt; } p;
shared uint values[64];
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    values[lane] = src[i];
    barrier();
    uint value = values[lane ^ 1u];
    if (i < p.count)
        dst[i] = (value * 1664525u + 1013904223u) ^ p.salt;
}
