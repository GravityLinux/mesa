#version 460
#extension GL_EXT_mesh_shader : require
#ifndef THREADS
#define THREADS 16
#endif
#ifndef PRIMITIVE
#define PRIMITIVE 0
#endif
layout(local_size_x=THREADS) in;
layout(triangles, max_vertices=3, max_primitives=1) out;
layout(set=0, binding=0, std430) readonly buffer Input { uint values[]; } input_data;
#if PRIMITIVE
layout(location=0) perprimitiveEXT out Data { vec4 values[3]; } data[];
#else
layout(location=0) out Data { vec4 values[3]; } data[];
#endif
shared uint scratch[7168];
void main()
{
   uint lane = gl_LocalInvocationIndex;
   scratch[lane] = lane;
   barrier();
   SetMeshOutputsEXT(3, 1);
   if (lane == 0) {
      float x = float(scratch[0]);
      gl_MeshVerticesEXT[0].gl_Position = vec4(-.5+x, -.5, .5, 1);
      gl_MeshVerticesEXT[1].gl_Position = vec4(.5+x, -.5, .5, 1);
      gl_MeshVerticesEXT[2].gl_Position = vec4(x, .5, .5, 1);
      gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
#if PRIMITIVE
      const uint count = 1;
#else
      const uint count = 3;
#endif
      for (uint v = 0; v < count; ++v) {
         for (uint j = 0; j < 3; ++j) {
            uint slot = (input_data.values[0] + j) % 3;
            data[v].values[slot] = vec4(float(v), float(j), .5, 1);
         }
      }
   }
}
